[
  {
    "title": {
      "en": "Misting"
    },
    "description": {
      "en": "Mistings are by far the most common type of Metalborn across both eras."
    },
    "public": true,
    "only": ["scan_1", "scan_2"],
    "initial_talents": ["Misting Snap"],
    "features": [
      {
        "title": {
          "en": "Allomantic Power"
        },
        "description": {
          "en": "Choose one of the following powers."
        },
        "kind": "one_from_list",
        "options": [
          { "title": { "en": "Aluminum" } },
          { "title": { "en": "Atium" } },
          { "title": { "en": "Bendalloy" } },
          { "title": { "en": "Brass" } },
          { "title": { "en": "Bronze" } },
          { "title": { "en": "Cadmium" } },
          { "title": { "en": "Chromium" } },
          { "title": { "en": "Copper" } },
          { "title": { "en": "Duralumin" } },
          { "title": { "en": "Electrum" } },
          { "title": { "en": "Gold" } },
          { "title": { "en": "Iron" } },
          { "title": { "en": "Nicrosil" } },
          { "title": { "en": "Pewter" } },
          { "title": { "en": "Steel" } },
          { "title": { "en": "Tin" } },
          { "title": { "en": "Zinc" } }
        ]
      },
      {
        "required_for": ["Invested", "Instinctual Burn"],
        "extra_skills": ["allomancy", "allomancy"],
        "extra_feats": ["Allomantic Power"],
        "title": {
          "en": "Misting Snap"
        },
        "description": {
          "en": "**Prerequisite** Human or koloss-blooded ancestry; no other Snap or Heritage talent.\n\nGain an Investiture score, the Drink Vial action, the Allomancy skill, and one nascent Allomantic power."
        },
        "kind": "static",
        "investiture": true
      },
      {
        "required_for": ["Powerhouse", "Trace Metals"],
        "title": {
          "en": "Invested"
        },
        "description": {
          "en": "Your max Investiture increases by your tier."
        },
        "kind": "update_result",
        "modifiers": { "investiture_max": { "type": "add", "value": "tier" } }
      },
      {
        "required_for": ["Allomantic Savantism"],
        "title": {
          "en": "Powerhouse"
        },
        "description": {
          "en": "Your power's range increases by one rank in Allomancy, and maintaining its effect costs 1 fewer Investiture."
        },
        "kind": "static"
      },
      {
        "title": {
          "en": "Trace Metals"
        },
        "description": {
          "en": "**Prerequisite** Allomancy 3+.\n\nUse the nascent version of your Allomantic powers even while at 0 Investiture or otherwise Depleted."
        },
        "kind": "static"
      },
      {
        "title": {
          "en": "Allomantic Savantism"
        },
        "description": {
          "en": "**Prerequisite** Allomancy 5+.\n\nAfter you complete the **Become a Savant** goal, your power is amplified by 2 Investiture. While Depleted, you suffer withdrawal."
        },
        "kind": "static"
      },
      {
        "title": {
          "en": "Instinctual Burn"
        },
        "description": {
          "en": "**Prerequisite** Allomancy 3+.\n\nAfter a long rest, choose one of your Allomantic powers. You can use its Burn action before each scene."
        },
        "kind": "text"
      }
    ]
  },
  {
    "title": {
      "en": "Mistborn"
    },
    "description": {
      "en": "Mistborn are the most iconic and legendary Metalborn of Scadrial."
    },
    "public": true,
    "only": ["scan_1"],
    "initial_talents": ["Mistborn Snap"],
    "features": [
      {
        "required_for": ["Invested", "Metallic Splash"],
        "extra_skills": ["allomancy"],
        "title": {
          "en": "Mistborn Snap"
        },
        "description": {
          "en": "**Prerequisite** Human ancestry; no other Snap or Heritage talent.\n\nGain an Investiture score, the Drink Vial action, the Allomancy skill, and all nascent Allomantic powers."
        },
        "kind": "static",
        "investiture": true
      },
      {
        "required_for": ["Metallic Splash", "Trace Metals"],
        "title": {
          "en": "Invested"
        },
        "description": {
          "en": "Your max Investiture increases by your tier."
        },
        "kind": "update_result",
        "modifiers": { "investiture_max": { "type": "add", "value": "tier" } }
      },
      {
        "title": {
          "en": "Trace Metals"
        },
        "description": {
          "en": "**Prerequisite** Allomancy 3+.\n\nUse the nascent version of your Allomantic powers even while at 0 Investiture or otherwise Depleted."
        },
        "kind": "static"
      },
      {
        "required_for": ["Selective Burn", "Instinctual Burn"],
        "title": {
          "en": "Metallic Splash"
        },
        "description": {
          "en": "When you make a test for an Allomantic power, spend to also use another nascent power."
        },
        "kind": "static"
      },
      {
        "title": {
          "en": "Selective Burn"
        },
        "description": {
          "en": "**Prerequisite** Allomancy 3+.\n\nUse an Allomantic power by becoming Depleted of that power instead of spending Investiture."
        },
        "kind": "static"
      },
      {
        "required_for": ["Simultaneous Burn"],
        "title": {
          "en": "Instinctual Burn"
        },
        "description": {
          "en": "**Prerequisite** Allomancy 3+.\n\nAfter a long rest, choose one of your Allomantic powers. You can use its Burn action before each scene."
        },
        "kind": "static"
      },
      {
        "title": {
          "en": "Simultaneous Burn"
        },
        "description": {
          "en": "**Prerequisite** Allomancy 4+.\n\n**Spend 2 focus** to gain 2 actions for activating your Allomantic powers."
        },
        "kind": "static"
      }
    ]
  },
